# =============================================================================
# TravelLTK environment variables
# Copy this file to .env.local and fill in values. Validated at boot by
# lib/config.ts — missing or malformed values fail fast in development.
# =============================================================================

# Public site origin (used for canonical URLs, Auth.js callbacks, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS API Gateway HTTP API base URL (wired after Phase 7 `cdk deploy`)
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_API_BASE_URL=

# CloudFront distribution for creator media (wired after Phase 7)
NEXT_PUBLIC_MEDIA_BASE_URL=

# -----------------------------------------------------------------------------
# Auth.js (NextAuth) — session signing
# Generate locally with: `openssl rand -base64 32`
# -----------------------------------------------------------------------------
AUTH_SECRET=

# -----------------------------------------------------------------------------
# AWS Cognito User Pool (configured by the CDK stack in /infra, Phase 7)
# These values are NOT generated by this Next.js app. After `cdk deploy`,
# copy the stack outputs into this file / Vercel env.
#
# Google OAuth client ID and secret are created in Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client) and passed into CDK
# as context parameters. Cognito uses them as a federated identity provider.
# The Next.js app never talks to Google directly — Auth.js talks to Cognito's
# hosted UI, and Cognito federates to Google.
# -----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Hosted UI domain, without protocol. Example: travelltk-auth.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
# Region the User Pool lives in
COGNITO_REGION=us-east-1
# Issuer URL, typically https://cognito-idp.{region}.amazonaws.com/{userPoolId}
COGNITO_ISSUER=

# Google OAuth credentials (Google Cloud Console). Stored here so local
# Auth.js/Cognito docs can reference them; the live federation is configured
# on the Cognito User Pool, not by this app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Stripe (shopper checkout + creator Connect payouts)
# Keys come from https://dashboard.stripe.com/apikeys — prefer a restricted
# API key (rk_test_...) over a secret key. Never commit live keys.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# -----------------------------------------------------------------------------
# Instagram Graph (homepage creator carousel + Eileen Gu hero)
# Business Discovery of other professional accounts requires a token with
# instagram_basic, pages_read_engagement, AND instagram_manage_insights, on an
# app that is live (or the discovered account is a role on the app).
# Without insights permission, the homepage still features the creators and
# links to Instagram, using editorial photography until Graph can return media.
# https://developers.facebook.com/docs/instagram-platform/instagram-api-with-facebook-login/business-discovery
# -----------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Instagram Login (creator onboarding — ownership + follower check)
# Instagram API with Instagram Login: the creator signs in with Instagram
# directly. They do not need a Facebook Page.
# Redirect URI must match the Meta app exactly (including trailing slash).
# Local: http://localhost:3000/api/instagram/callback
# Production (Meta Valid OAuth Redirect URI): https://www.travelltk.com/api/instagram/callback
# On Vercel production, a localhost INSTAGRAM_REDIRECT_URI is ignored.
# -----------------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
MIN_FOLLOWER_COUNT=400000

# Encrypts Instagram long-lived tokens at rest. Separate from the database.
# 64-char hex (32 bytes) or any passphrase (hashed to 32 bytes).
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Comma-separated emails that may manually verify creator applications.
ADMIN_EMAILS=

# Vercel Cron authorization for token refresh. openssl rand -hex 24
CRON_SECRET=

